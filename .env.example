# Environment Configuration Template
# Copy this file to .env and insert your API credentials

# Gemini API Key (Required for Grounded GenAI Market Summaries & Explanations)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Web Search or News API keys
SERPER_API_KEY=your_serper_api_key_here

# Optional: Custom Port or Streamlit Settings
STREAMLIT_SERVER_PORT=8501
